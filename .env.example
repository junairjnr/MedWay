# Canonical production URL (metadata, sitemap, JSON-LD, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.medwaymobility.ca

# Google Search Console — optional override (default is set in src/lib/seo.ts)
GOOGLE_SITE_VERIFICATION=aLG0JBKJKXP0r2MVGMP-xQaXgu_rCN7OrlrFi2L9xME

# EmailJS — https://www.emailjs.com/
# Add the same variables in Vercel → Settings → Environment Variables, then redeploy.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=yJ4MKjxw8243KaNOL
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_den16kl
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=template_k83ubdm


# Optional: separate templates for product enquiry and newsletter.
# Leave unset to reuse the contact template.
# NEXT_PUBLIC_EMAILJS_INQUIRY_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_NEWSLETTER_TEMPLATE_ID=

# Client inbox used inside EmailJS template params as {{to_email}}.
# Also set the same address as the "To Email" field in your EmailJS template.
ADMIN_EMAIL=medwaymobility@outlook.com
