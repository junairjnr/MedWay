# EmailJS — https://www.emailjs.com/
# Add the same variables in Vercel → Settings → Environment Variables, then redeploy.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id

# Optional: separate templates for product enquiry and newsletter.
# Leave unset to reuse the contact template.
# NEXT_PUBLIC_EMAILJS_INQUIRY_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_NEWSLETTER_TEMPLATE_ID=

# Client inbox used inside EmailJS template params as {{to_email}}.
# Also set the same address as the "To Email" field in your EmailJS template.
